<resources>
    <style name="Dialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">@color/colorAccent</item>
    </style>

    <style name="Dialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">@color/colorAccent</item>
    </style>

    <style name="Theme.Televe" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:alertDialogTheme">@style/Dialog.Dark</item>
        <item name="android:actionBarTheme">@android:style/ThemeOverlay.Material.Dark.ActionBar</item>
        <item name="android:actionBarPopupTheme">@android:style/ThemeOverlay.Material</item>
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorAccent">#42A5F5</item>
        <item name="android:colorControlHighlight">#80FFFFFF</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
