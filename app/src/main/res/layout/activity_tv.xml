<?xml version="1.0" encoding="utf-8"?>
<io.library.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.library.exo.PlayerView
        android:id="@+id/player"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"/>

    <FrameLayout
        android:id="@+id/radio_panel"
        android:theme="@style/Theme.AppCompat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#171B1A"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#82D6B0"
                android:importantForAccessibility="no"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/radio_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#B7C2BC"
                android:textSize="14sp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/radio_title"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#F3F5F3"
                android:textSize="28sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeStepGranularity="1sp"/>

            <TextView
                android:id="@+id/radio_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#82D6B0"
                android:textSize="16sp"
                android:accessibilityLiveRegion="polite"/>

            <TextView
                android:id="@+id/radio_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#B7C2BC"
                android:textSize="14sp"/>

        </LinearLayout>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        style="?android:attr/progressBarStyle"/>

    <TextView
        android:id="@+id/channel_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:maxWidth="320dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:padding="12dp"
        android:background="#C0000000"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:importantForAccessibility="yes"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"/>

    <include layout="@layout/action_toolbar"/>

    <!--Don't use RelativeLayout which cause key navigation issue-->
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/drawer_background"
        android:fitsSystemWindows="true"
        android:layout_gravity="left"
        tools:ignore="RtlHardcoded"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_size">

            <TextView
                android:id="@+id/provider"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="96dp"
                android:text="@string/channel_list_loading"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/time"
                android:layout_gravity="end|center_vertical"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="0dp"
                android:paddingEnd="24dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_menu"
                android:fadeScrollbars="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"/>

            <TextView
                android:id="@+id/playlist_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/channel_list_loading"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:accessibilityLiveRegion="polite"/>

        </FrameLayout>

    </LinearLayout>

</io.library.widget.DrawerLayout>
